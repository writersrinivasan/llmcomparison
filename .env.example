# Copy to .env.local. Without a key the advisor runs in offline (rule-based) mode.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-opus-5-5
# ANTHROPIC_MODEL=claude-opus-5-5
# Optional server-wide Groq key (users can also bring their own key in the UI)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b
